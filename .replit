# Replit configuration — import this repo on Replit and the workspace +
# deployment come preconfigured. See docs/LIVE-TEXTBOOK.md §14.3.

# Workspace (dev) — Express API on :3000 + Vite (proxies /api to it) with
# --host so the Replit webview can reach it.
run = ["sh", "-c", "npm run dev:server & npm run dev -- --host"]
modules = ["nodejs-20"]
hidden = [".config", "node_modules", "dist", "playwright-report", "test-results"]

[deployment]
# Autoscale runs server/index.ts: serves the built SPA (with fallback
# routing) plus /api — Replit Auth, review-event sync, telemetry.
# Needs: a production Postgres database attached + SESSION_SECRET secret.
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3000
externalPort = 80
